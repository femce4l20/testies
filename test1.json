    menuRoot.Size = UDim2.fromOffset(360, 190)
    menuRoot.Position = UDim2.new(0.5, -180, 0.5, -75)
    menuRoot.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
    menuRoot.BorderSizePixel = 0
    menuRoot.Active = true
    menuRoot.Parent = host
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 10)
    corner.Parent = menuRoot
else
    menuRoot = host
    menuRoot.Active = true
end

-- --- Dragging --------------------------------------------------
local dragging, dragStart, startPos = false, nil, nil
local function updateDrag(input)
    local delta = input.Position - dragStart
    menuRoot.Position = UDim2.new(
        startPos.X.Scale, startPos.X.Offset + delta.X,
        startPos.Y.Scale, startPos.Y.Offset + delta.Y
    )
end

menuRoot.InputBegan:Connect(function(input)
    if not isCurrentRun() then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = menuRoot.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)
menuRoot.InputChanged:Connect(function(input)
    if not isCurrentRun() then return end
    if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then
        if dragging then updateDrag(input) end
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if not isCurrentRun() then return end
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch) then
        updateDrag(input)
    end
end)

