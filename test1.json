--[[
    Recursive Server Hopper

    CONFIGURATION
]]

local AUTO_REJOIN = true
local REJOIN_SAME_SERVER = false
local recursive_execution = true

-- Raw URL containing this Lua script.
-- The extension does NOT matter as long as the response body is Lua.
local SCRIPT_URL =
    "https://raw.githubusercontent.com/femce4l20/testies/refs/heads/main/test1.json"

local MAX_SERVER_PAGES = 100

local INITIAL_DELAY = 1.5
local TELEPORT_DELAY = 0.5

local VISITED_SETTING =
    "RecursiveServerHop_Visited_v4"


--==============================================================
-- SERVICES
--==============================================================

local Players =
    game:GetService("Players")

local TeleportService =
    game:GetService("TeleportService")

local HttpService =
    game:GetService("HttpService")

local LocalPlayer =
    Players.LocalPlayer


--==============================================================
-- EXECUTOR COMPATIBILITY
--==============================================================

local function getQueueTeleport()

    if type(queue_on_teleport) == "function" then
        return queue_on_teleport
    end

    if syn
        and type(syn.queue_on_teleport) == "function" then

        return syn.queue_on_teleport
    end

    if fluxus
        and type(fluxus.queue_on_teleport) == "function" then

        return fluxus.queue_on_teleport
    end

    return nil
end

local queueteleport =
    getQueueTeleport()


--==============================================================
-- HTTP
--==============================================================

local function getHttp()

    if type(game.HttpGet) == "function" then

        return function(url)
            return game:HttpGet(url)
        end

    end

    local requestFunction =
        request
        or http_request
        or (syn and syn.request)
        or (fluxus and fluxus.request)

    if type(requestFunction) == "function" then

        return function(url)

            local response =
                requestFunction({
                    Url = url,
                    Method = "GET"
                })

            if response
                and response.Body then

                return response.Body
            end

            error(
                "HTTP request returned no body"
            )
        end
    end

    return nil
end

local httpGet =
    getHttp()


--==============================================================
-- VALIDATION
--==============================================================

if not AUTO_REJOIN then

    warn(
        "[RecursiveHop] AUTO_REJOIN = false"
    )

    return
end

if not SCRIPT_URL
    or SCRIPT_URL == ""
    or SCRIPT_URL:find(
        "YOUR%-RAW%-SCRIPT%-URL"
    ) then

    warn(
        "[RecursiveHop] Invalid SCRIPT_URL."
    )

    return
end

if recursive_execution
    and not queueteleport then

    warn(
        "[RecursiveHop] queue_on_teleport unavailable."
    )

    return
end

if not httpGet then

    warn(
        "[RecursiveHop] No HTTP function available."
    )

    return
end


--==============================================================
-- SERVER VISIT STORAGE
--==============================================================

local visited = {}


local function loadVisited()

    local success, stored =
        pcall(function()

            return TeleportService:
                GetTeleportSetting(
                    VISITED_SETTING
                )

        end)

    if not success then

        warn(
            "[RecursiveHop] Failed to load visited list:",
            stored
        )

        return
    end

    if typeof(stored) == "table" then

        for jobId, value in pairs(stored) do

            if value == true then
                visited[
                    tostring(jobId)
                ] = true
            end

        end

        return
    end

    if typeof(stored) == "string"
        and stored ~= "" then

        local decodeSuccess, decoded =
            pcall(function()

                return HttpService:
                    JSONDecode(stored)

            end)

        if decodeSuccess
            and typeof(decoded) == "table" then

            for jobId, value in pairs(decoded) do

                if value == true then
                    visited[
                        tostring(jobId)
                    ] = true
                end

            end
        end
    end
end


local function saveVisited()

    local copy = {}

    for jobId, value in pairs(visited) do

        if value then
            copy[
                tostring(jobId)
            ] = true
        end

    end

    local success, err =
        pcall(function()

            TeleportService:
                SetTeleportSetting(
                    VISITED_SETTING,
                    copy
                )

        end)

    if success then
        return true
    end

    warn(
        "[RecursiveHop] Table save failed:",
        err
    )

    local encodeSuccess, encoded =
        pcall(function()

            return HttpService:
                JSONEncode(copy)

        end)

    if not encodeSuccess then
        return false
    end

    local fallbackSuccess, fallbackErr =
        pcall(function()

            TeleportService:
                SetTeleportSetting(
                    VISITED_SETTING,
                    encoded
                )

        end)

    if not fallbackSuccess then

        warn(
            "[RecursiveHop] JSON save failed:",
            fallbackErr
        )

        return false
    end

    return true
end


loadVisited()


--==============================================================
-- CURRENT SERVER
--==============================================================

local currentJobId =
    tostring(game.JobId)

print(
    "[RecursiveHop] Current server:",
    currentJobId
)

if currentJobId ~= "" then

    visited[currentJobId] = true

    saveVisited()
end


--==============================================================
-- REINJECTION
--
-- IMPORTANT:
-- We register OnTeleport immediately.
--
-- We ALSO have queueForTeleport(), which is called immediately
-- before initiating the teleport.
--
-- This gives executors two opportunities to register the loader.
-- The guard prevents duplicate queueing during one teleport.
--==============================================================

local teleportQueueRegistered = false


local function buildQueuedLoader()

    -- Keep this in the same form as the supplied Infinite Yield
    -- implementation.

    return "loadstring(game:HttpGet('"
        .. SCRIPT_URL
        .. "'))()"
end


local function queueForTeleport()

    if not recursive_execution then
        return false
    end

    if teleportQueueRegistered then
        return true
    end

    if not queueteleport then

        warn(
            "[RecursiveHop] queue_on_teleport unavailable."
        )

        return false
    end

    local code =
        buildQueuedLoader()

    print(
        "[RecursiveHop] Registering teleport loader..."
    )

    local success, err =
        pcall(function()

            queueteleport(code)

        end)

    if not success then

        warn(
            "[RecursiveHop] queue_on_teleport failed:",
            err
        )

        return false
    end

    teleportQueueRegistered = true

    print(
        "[RecursiveHop] Teleport loader registered."
    )

    return true
end


--==============================================================
-- ON TELEPORT FALLBACK
--==============================================================

Players.LocalPlayer.OnTeleport:Connect(
    function(state)

        print(
            "[RecursiveHop] OnTeleport:",
            tostring(state)
        )

        if not recursive_execution then
            return
        end

        -- If the pre-teleport queue somehow wasn't registered,
        -- register it from OnTeleport just like Infinite Yield.
        if not teleportQueueRegistered then

            queueForTeleport()

        end
    end
)


--==============================================================
-- SERVER API
--==============================================================

local function fetchServers()

    local servers = {}
    local cursor = nil

    for page = 1, MAX_SERVER_PAGES do

        local url =
            ("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100")
            :format(game.PlaceId)

        if cursor
            and cursor ~= "" then

            url =
                url
                .. "&cursor="
                .. HttpService:UrlEncode(
                    cursor
                )
        end

        local body

        local requestSuccess, requestErr =
            pcall(function()

                body = httpGet(url)

            end)

        if not requestSuccess then

            warn(
                "[RecursiveHop] Server API failed:",
                requestErr
            )

            break
        end

        local data

        local decodeSuccess, decodeErr =
            pcall(function()

                data =
                    HttpService:
                    JSONDecode(body)

            end)

        if not decodeSuccess then

            warn(
                "[RecursiveHop] Server JSON failed:",
                decodeErr
            )

            break
        end

        if typeof(data) ~= "table" then

            warn(
                "[RecursiveHop] Invalid server response."
            )

            break
        end

        if typeof(data.data) == "table" then

            for _, server in ipairs(data.data) do

                if server.id then

                    table.insert(
                        servers,
                        server
                    )

                end

            end
        end

        cursor =
            data.nextPageCursor

        if not cursor
            or cursor == "" then

            break
        end
    end

    return servers
end


--==============================================================
-- SERVER SELECTION
--==============================================================

local function getCandidates()

    local servers =
        fetchServers()

    print(
        "[RecursiveHop] Servers returned:",
        #servers
    )

    local preferred = {}
    local fallback = {}

    for _, server in ipairs(servers) do

        local jobId =
            tostring(server.id)

        local isCurrent =
            jobId == currentJobId

        local alreadyVisited =
            visited[jobId] == true

        if not alreadyVisited
            and (
                REJOIN_SAME_SERVER
                or not isCurrent
            ) then

            table.insert(
                fallback,
                server
            )

            local playing =
                tonumber(
                    server.playing
                ) or 0

            local maxPlayers =
                tonumber(
                    server.maxPlayers
                ) or 0

            if maxPlayers <= 0
                or playing < maxPlayers then

                table.insert(
                    preferred,
                    server
                )

            end
        end
    end

    if #preferred > 0 then
        return preferred
    end

    return fallback
end


local function chooseServer()

    local candidates =
        getCandidates()

    if #candidates == 0 then
        return nil
    end

    return candidates[
        math.random(
            1,
            #candidates
        )
    ]
end


--==============================================================
-- DONE UI
--==============================================================

local function showDone()

    local PlayerGui =
        LocalPlayer:
        FindFirstChildOfClass(
            "PlayerGui"
        )

    if not PlayerGui then
        return
    end

    local old =
        PlayerGui:
        FindFirstChild(
            "RecursiveHopDone"
        )

    if old then
        old:Destroy()
    end

    local gui =
        Instance.new("ScreenGui")

    gui.Name =
        "RecursiveHopDone"

    gui.ResetOnSpawn =
        false

    gui.IgnoreGuiInset =
        true

    gui.DisplayOrder =
        2147483647


    local background =
        Instance.new("Frame")

    background.Size =
        UDim2.fromScale(
            1,
            1
        )

    background.BorderSizePixel =
        0

    background.BackgroundColor3 =
        Color3.fromRGB(
            0,
            0,
            0
        )

    background.Parent =
        gui


    local label =
        Instance.new("TextLabel")

    label.AnchorPoint =
        Vector2.new(
            0.5,
            0.5
        )

    label.Position =
        UDim2.fromScale(
            0.5,
            0.5
        )

    label.Size =
        UDim2.fromScale(
            0.8,
            0.2
        )

    label.BackgroundTransparency =
        1

    label.Text =
        "done."

    label.TextColor3 =
        Color3.fromRGB(
            255,
            255,
            255
        )

    label.TextScaled =
        true

    label.Font =
        Enum.Font.GothamBold

    label.Parent =
        background

    gui.Parent =
        PlayerGui
end


--==============================================================
-- DESTROY PARTS
--==============================================================

local function destroyEveryPart()

    local descendants =
        game:GetDescendants()

    local destroyed =
        0

    for _, instance in ipairs(
        descendants
    ) do

        if instance:IsA(
            "BasePart"
        ) then

            pcall(function()

                instance:Destroy()

                destroyed += 1

            end)

        end
    end

    pcall(function()

        local terrain =
            workspace:
            FindFirstChildOfClass(
                "Terrain"
            )

        if terrain then
            terrain:Clear()
        end

    end)

    print(
        "[RecursiveHop] Destroyed parts:",
        destroyed
    )
end


--==============================================================
-- TELEPORT
--==============================================================

local function teleportToServer(server)

    if not server
        or not server.id then

        return false
    end

    local targetJobId =
        tostring(server.id)

    if targetJobId == "" then
        return false
    end

    -- Never target an already visited JobId.
    if visited[targetJobId] then

        print(
            "[RecursiveHop] Refusing visited server:",
            targetJobId
        )

        return false
    end

    if not REJOIN_SAME_SERVER
        and targetJobId == currentJobId then

        print(
            "[RecursiveHop] Refusing current server."
        )

        return false
    end


    --==========================================================
    -- MARK TARGET BEFORE TELEPORT
    --==========================================================

    visited[targetJobId] = true
    saveVisited()


    --==========================================================
    -- RESET QUEUE STATE FOR THIS TELEPORT
    --==========================================================

    teleportQueueRegistered =
        false


    --==========================================================
    -- QUEUE BEFORE TELEPORT
    --
    -- This is the important fix.
    --
    -- We don't wait for OnTeleport to queue the script.
    --==========================================================

    if recursive_execution then

        local queued =
            queueForTeleport()

        if not queued then

            warn(
                "[RecursiveHop] Could not queue reinjection."
            )

            -- Undo target reservation because we never
            -- successfully started the teleport.
            visited[targetJobId] =
                nil

            saveVisited()

            return false
        end
    end


    print(
        "[RecursiveHop] Next server:",
        targetJobId
    )

    task.wait(
        TELEPORT_DELAY
    )


    --==========================================================
    -- TELEPORT
    --==========================================================

    local success, err =
        pcall(function()

            TeleportService:
                TeleportToPlaceInstance(
                    game.PlaceId,
                    targetJobId,
                    LocalPlayer
                )

        end)

    if not success then

        warn(
            "[RecursiveHop] Teleport call failed:",
            err
        )

        visited[targetJobId] =
            nil

        saveVisited()

        return false
    end

    print(
        "[RecursiveHop] Teleport request sent."
    )

    return true
end


--==============================================================
-- MAIN
--==============================================================

task.wait(
    INITIAL_DELAY
)


--==============================================================
-- KEEP TRYING UNTIL A TELEPORT STARTS
--==============================================================

local attempts = 0

while true do

    attempts += 1

    if attempts > 50 then

        warn(
            "[RecursiveHop] Too many failed server attempts."
        )

        break
    end


    local target =
        chooseServer()


    if not target then

        print(
            "[RecursiveHop] No unvisited public servers found."
        )

        break
    end


    local success =
        teleportToServer(
            target
        )


    if success then

        -- Once the teleport begins, this copy of the script
        -- is expected to leave this server.
        return
    end

    -- The target failed. Find a different one.
    task.wait(0.5)
end


--==============================================================
-- EXHAUSTED
--==============================================================

task.wait(0.5)

destroyEveryPart()

showDone()

print(
    "[RecursiveHop] done."
)
