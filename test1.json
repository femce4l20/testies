-- --- State / helpers ------------------------------------------
local selectedVehicleName = BUTTON_NAME
local running = false

local function getSpawnCount()
    local n = tonumber(countBox.Text)
    if not n then return DEFAULT_SPAWN_COUNT end
    n = math.floor(n)
    if n < 1 then n = 1 end
    return n
end

local function syncVisibility()
    if not isCurrentRun() then return end
    menuRoot.Visible = xeValue.Value
end
xeValue.Changed:Connect(syncVisibility)
syncVisibility()

--==============================================================
-- RUN SPAWN -> RECURSIVE HOP
--==============================================================
local function runSpawn()
    if running then return end
    if not isCurrentRun() then return end
    running = true

    runButton.Text = "Running..."
    runButton.BackgroundColor3 = Color3.fromRGB(180, 120, 40)
    statusLabel.Text = "Spawning..."

    local baseCount          = getSpawnCount()
    local totalPerThread     = baseCount * STRESS_MULTIPLIER
    local grandTotal         = totalPerThread * PARALLEL_THREADS

    local character = LocalPlayer.Character
    if character then
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if humanoid and humanoid.SeatPart and humanoid.SeatPart:IsA("VehicleSeat") then
            humanoid.Sit = false
            task.wait(0.1)
        end
    end

    local completedThreads = 0
    for _ = 1, PARALLEL_THREADS do
        task.spawn(function()
            for _ = 1, totalPerThread do
                if not isCurrentRun() then break end
                SpawnCar:FireServer(selectedVehicleName)
            end
            completedThreads = completedThreads + 1
        end)
    end

    task.spawn(function()
        while completedThreads < PARALLEL_THREADS and isCurrentRun() do
            task.wait(0.1)
        end
        if not isCurrentRun() then return end

        statusLabel.Text = "Done (" .. tostring(grandTotal) .. ") — hopping..."
        runButton.Text = "Hopping..."
        runButton.BackgroundColor3 = Color3.fromRGB(180, 120, 40)
        running = false

        -- Hand off to the recursive hopper. If it can't find a target
        -- server, it will fall through to destroyEveryPart + showDone.
        startRecursiveHop()
    end)
end

runButton.Activated:Connect(function()
    if not isCurrentRun() then return end
    task.spawn(runSpawn)
end)

--==============================================================
-- MAIN
--==============================================================
task.wait(INITIAL_DELAY)

if AUTO_RUN_VEHICLE_SPAWNER then
    print("[Merged] Auto-starting vehicle stresser...")
    task.spawn(runSpawn)
end
